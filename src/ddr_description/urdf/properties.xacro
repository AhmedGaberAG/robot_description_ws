<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Base -->
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />

    <!-- Wheels -->
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />
    <xacro:property name="caster_radius" value="${wheel_radius / 2.0}" />

    <!-- LiDAR -->
    <xacro:property name="lidar_radius" value="0.0484" />
    <xacro:property name="lidar_length" value="0.0403" />

    <!-- Camera -->
    <xacro:property name="camera_length" value="0.025" />
    <xacro:property name="camera_width" value="0.024" />
    <xacro:property name="camera_height" value="0.009" />

    <!-- IMU -->
    <xacro:property name="imu_length" value="0.04" />
    <xacro:property name="imu_width" value="0.03" />
    <xacro:property name="imu_height" value="0.01" />

    <!-- Materials -->
    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <material name="green">
        <color rgba="0 1 0 1" />
    </material>

    <material name="blue">
        <color rgba="0 0 1 1" />
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1" />
    </material>

</robot>